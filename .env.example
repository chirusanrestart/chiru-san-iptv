# Porta HTTP local do Chiru-san IPTV
PORT=18080
HOST=::

# Catálogo do Google Fotos
GOOGLE_PHOTOS_ALBUM_URL=https://photos.app.goo.gl/ieE9pLKupTC7TxFU6
CATALOG_REFRESH_MS=300000

# HLS: sem reencodificação, segmentos-alvo de 4 segundos
HLS_SEGMENT_SECONDS=4
# Janela de cache em segundos (180 = aproximadamente 3 minutos)
HLS_CACHE_SECONDS=180
FFMPEG_PATH=ffmpeg

# Relay Hostless: tunnel de bytes
TUNNEL_RELAY_URL=https://melissa-iptv.hostless.app
# Opcional: define o receiver que será exibido na página inicial do Termux.
# Sem isso, o receiver é gerado por vídeo com: npm run tunnel -- <id>
# TUNNEL_STREAM_ID=ID-DO-VIDEO

# Cache de segmentos HLS no Hostless (o tunnel continua independente)
HOSTLESS_CACHE_ENABLED=true
HOSTLESS_CACHE_URL=https://melissa-iptv.hostless.app
# Chave compartilhada com AGENT_TOKEN nas variáveis do app Hostless.
# Necessária para o túnel reverso automático (não é usada pelo player).
# HOSTLESS_AGENT_TOKEN=COLOQUE_A_MESMA_CHAVE_CONFIGURADA_NO_HOSTLESS
# Quantidade de requisições simultâneas encaminhadas pelo túnel (1 a 8).
HOSTLESS_AGENT_WORKERS=3
# Validade dos segmentos remotos; padrão = janela HLS + 120s, máximo 3600s
HOSTLESS_CACHE_TTL_SECONDS=300

# Máximo de processos FFmpeg simultâneos no Termux
HLS_MAX_JOBS=2
# Encerra processos HLS sem requisições após 90 segundos
HLS_IDLE_MS=90000
