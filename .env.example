# Porta HTTP local do Chiru-san IPTV
PORT=18080
HOST=::

# Catálogo do Google Fotos
GOOGLE_PHOTOS_ALBUM_URL=https://photos.app.goo.gl/ieE9pLKupTC7TxFU6
CATALOG_REFRESH_MS=300000

# HLS: sem reencodificação, segmentos-alvo de 4 segundos
HLS_SEGMENT_SECONDS=4
# Janela de cache em segundos (180 = aproximadamente 3 minutos)
HLS_CACHE_SECONDS=180
FFMPEG_PATH=ffmpeg

# Relay Hostless: tunnel de bytes
TUNNEL_RELAY_URL=https://melissa-iptv.hostless.app
